# Which provider to use: gemini (free tier, default) | ollama (free, runs locally) | openai (paid)
LLM_PROVIDER=gemini

# --- Gemini (free key from https://aistudio.google.com/apikey) ---
GOOGLE_API_KEY=
# Optional model overrides (defaults are defined in src/config.py)
CHAT_MODEL=gemini-3.5-flash
EMBEDDING_MODEL=

# --- OpenAI (only if LLM_PROVIDER=openai) ---
OPENAI_API_KEY=

# --- Optional: Langfuse tracing (leave blank to disable; the bot works without it) ---
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# EU cloud: https://cloud.langfuse.com   US cloud: https://us.cloud.langfuse.com
LANGFUSE_HOST=https://cloud.langfuse.com
